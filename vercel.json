{
  "framework": "go",
    "builds": [
      {
        "src": "main.go",
        "use": "@vercel/go",
        "config": {
          "includeFiles": ["web/**/*", "accounts.json"]
        }
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "/api/$1"
      },
      {
        "src": "/(.*)",
        "dest": "/api"
      }
    ]
  }
